.DS_Store
*.tmp
.idea/
.env
infra/openbao/secrets/

# OpenTofu state holds the generated Cloud SQL password in plain text --
# never committed, same reasoning as every other secret in this repo.
infra/opentofu/.terraform/
infra/opentofu/*.tfstate
infra/opentofu/*.tfstate.*
infra/opentofu/*.tfvars

# Set-aside pre-monorepo git history (see docs/DECISIONS.md) -- kept on
# disk for reference, never tracked by the new combined repo.
services/*/.git.old-history-backup/

# Per-service build output/dependency caches (Gradle/Kotlin, Node, Rust,
# Swift, Vite, Next.js) -- every language's own ignore list, kept here
# instead of per-service .gitignore files so the monorepo root is the
# single source of truth.
**/build/
**/.gradle/
**/node_modules/
**/dist/
**/.next/
**/target/
**/*.class
**/.DS_Store
infra/opentofu/tfplan
